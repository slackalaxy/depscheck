#!/bin/bash
#
# pkg-sync: automatically update packages generated by pkg-get

#set -euo pipefail
set -e

# Invalid option
if [[ -n "${1:-}" ]] && [[ "$1" != "-a" ]] && [[ "$1" != "--auto" ]] && [[ "$1" != "-h" ]] && [[ "$1" != "--help" ]]; then
	echo "$(basename "$0"): invalid option '$1'" >&2
	exit 1
fi

show_help() {
	echo "usage: $(basename $0) [option]"
	echo "options:"
	echo "  -a,  --auto      automatic, no prompts"
	echo "  -h,  --help      print help and exit"
	exit 0
}

if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
	show_help
fi

if [ "`id -u`" != "0" ]; then
	echo "pkg-sync: only root can sync packages"
	exit 1
fi

# we get PKGMK_COMPRESSION_MODE from here
. /etc/pkgmk.conf

# Get pkgdir location from the default place, specified in /etc/pkg-get.conf
PKGDIR=$(grep -v ^\# /etc/pkg-get.conf | grep "pkgdir" | head -1 | awk '{print $2}' | awk -F '|' '{print $1}')

# Check if pkgdir exists
if [[ -z "$PKGDIR" || ! -d "$PKGDIR" ]]; then
	echo "Error: PKGDIR not set or invalid" >&2
	exit 1
fi

# A function asking users whether to proceed
ask_user(){
	local response
	local question="${1}"
    
	# Default (empty) answer - Yes
	read -r -p "$question [Y/n] " response
	response=${response:-Y}

	if [[ ! $response =~ ^[Yy] ]]; then
		echo "Aborted."
		exit 1 
	fi
}

# A function to just run the step
run_step(){
	local step="${1}"	
	echo "Running: $step"
}

#export ask_user
#export run_step

# 1. Update ports
ports_up(){
	local proceed="${1}"	
	$proceed "Update ports (ports -u)?"
	
	ports -u
}

# 2. Sync pkg-get repo with upstream
pkg_get_sync(){
	local proceed="${1}"	
	$proceed "Sync packages repo (ports -u)?"
	
	rm -f $PKGDIR/*.tar.${PKGMK_COMPRESSION_MODE}
	rm -f $PKGDIR/{PKGDEPS,PKGINST,PKGREAD,PKGREPO}
	pkg-get sync
}

# 3. Remve orphaned ports
orphan_remove(){
	local proceed="${1}"
	$proceed "Search/remove orphaned packages?"
	
	removed=($(prtorphan))
	if (( ${#removed[@]} > 0 )); then
    		echo "=======> Remove orphaned pkgs."
    	prt-get remove $removed
	else
    		echo "===== No orphans."
	fi
}


# 4. Install missing deps
install_missing(){
	local proceed="${1}"
	$proceed "Search/install missing dependencies?"

	missing=($(missdeps))
	if (( ${#missing[@]} > 0 )); then
    		echo "=======> Install missing deps."
    		pkg-get depinst $missing
	else
    		echo "===== No missing deps."
	fi
}

# 5. Show what will be updated
pkg_get_diff(){
	local proceed="${1}"
	$proceed "Show updates (pkg-get diff)?"
	
	pkg-get diff
}

# 6. Update the system via pkg-get not prt-get
pkg_get_sysup(){
	local proceed="${1}"
	$proceed "Update system (pkg-get sysup)?"
	
	pkg-get sysup
}

# 7. Reinstall necessary packages after a revdep check
reinstall_revdep(){
	local proceed="${1}"
	$proceed "Reinstall anything reported by revdep?"
	
	echo "===== Running revdep."
	revdeps=($(revdep))
	if (( ${#revdeps[@]} > 0 )); then
		echo "=======> Reinstall rebuilt pkgs."
		pkg-get update $revdeps -fr
	else
		echo "===== No need to reinstall pkgs."
	fi
}

# Run without prompts, automatically
if [[ "$1" = "-a" ]] || [[ "$1" = "--auto" ]]; then
	ports_up run_step
	pkg_get_sync run_step
	orphan_remove run_step
	install_missing run_step
	pkg_get_diff run_step
	pkg_get_sysup run_step
	reinstall_revdep run_step
	
	exit 0
fi

ports_up ask_user
pkg_get_sync ask_user
orphan_remove ask_user
install_missing ask_user
pkg_get_diff ask_user
pkg_get_sysup ask_user
reinstall_revdep ask_user
